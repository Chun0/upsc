  "samples": [
    { "q": "Which of the following statements regarding the President of India is/are correct? 1. The President can be removed only for violation of the Constitution. 2. The President's veto over Money Bills is absolute.", "o": ["1 only", "2 only", "Both 1 and 2", "Neither 1 nor 2"], "a": 0, "x": "Statement 2 is wrong: the President cannot withhold assent to Money Bills — Article 111 makes his assent effectively mandatory. Removal under Article 61 is only for violation of the Constitution.", "s": "Polity & Governance", "t": "Executive & Judiciary", "d": 3 },
    { "q": "Consider the following pairs (National Park : State) — 1. Bandhavgarh : Madhya Pradesh, 2. Similipal : Odisha, 3. Namdapha : Arunachal Pradesh. How many pairs are correctly matched?", "o": ["Only one", "Only two", "All three", "None"], "a": 2, "x": "All three are correct. Bandhavgarh (MP), Similipal (Odisha), Namdapha (Arunachal Pradesh).", "s": "Environment & Ecology", "t": "Protected areas & species", "d": 1 },
    { "q": "Which of the following is NOT a component of the monetary policy framework of the RBI?", "o": ["Repo rate", "Cash Reserve Ratio", "Fiscal deficit target", "Marginal Standing Facility"], "a": 2, "x": "Fiscal deficit target is part of fiscal policy (government budget), not RBI's monetary policy toolkit.", "s": "Economy", "t": "Banking & financial system", "d": 2 },
    { "q": "The 'Great Barrier Reef' is located off the coast of which country?", "o": ["Indonesia", "Australia", "Philippines", "Madagascar"], "a": 1, "x": "Great Barrier Reef lies in the Coral Sea off Queensland, Australia — the world's largest coral reef system.", "s": "Geography", "t": "World geography & maps", "d": 1 },
    { "q": "With reference to 'Bharat Stage (BS) VI' emission norms, consider: 1. They cap particulate matter (PM) and nitrogen oxides (NOx) from vehicles. 2. BS-VI fuel has lower sulphur content than BS-IV. Which is/are correct?", "o": ["1 only", "2 only", "Both 1 and 2", "Neither"], "a": 2, "x": "BS-VI tightened PM/NOx limits and mandated 10 ppm sulphur fuel (vs 50 ppm in BS-IV). Both correct.", "s": "Science & Technology", "t": "Pollution & environmental laws", "d": 2 },
    { "q": "If the 4th day of a month is Friday, which day will be the 26th day of the same month?", "o": ["Saturday", "Sunday", "Wednesday", "Tuesday"], "a": 0, "x": "26 − 4 = 22 days = 3 weeks + 1 day → Friday + 1 = Saturday.", "s": "CSAT Aptitude", "t": "Logical reasoning", "d": 1 }
