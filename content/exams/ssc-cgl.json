        { "name": "Ratio, average, mixture & alligation", "weight": 0.12, "pyq": 4, "difficulty": 2, "sub": ["Partnership", "Ages"] },
        { "name": "Time & work, pipes, speed & distance", "weight": 0.17, "pyq": 5, "difficulty": 3, "sub": ["Boats & streams", "Trains"] },
        { "name": "Geometry & mensuration", "weight": 0.12, "pyq": 4, "difficulty": 3, "sub": ["Triangles", "Circles", "2D/3D figures"] },
        { "name": "Trigonometry & heights-distances", "weight": 0.08, "pyq": 3, "difficulty": 2, "sub": ["Identities", "Angles of elevation"] },
        { "name": "DI & statistics", "weight": 0.09, "pyq": 4, "difficulty": 2, "sub": ["Pie/bar/line charts", "Mean/median"] },
        { "name": "Algebra", "weight": 0.08, "pyq": 4, "difficulty": 2, "sub": ["Linear equations", "Quadratic", "Maxima-minima"] }
      ]
    },
