        { "name": "Reading comprehension", "weight": 0.2, "pyq": 4, "difficulty": 2, "sub": ["Passages", "Inference"] },
        { "name": "Cloze test & para jumbles", "weight": 0.2, "pyq": 4, "difficulty": 3, "sub": ["Fillers", "Sequence"] },
        { "name": "Spelling & active-passive/direct-indirect", "weight": 0.15, "pyq": 4, "difficulty": 2, "sub": ["Voice", "Narration"] }
      ]
    },
