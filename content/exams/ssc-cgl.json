        { "name": "Coding-decoding", "weight": 0.15, "pyq": 4, "difficulty": 2, "sub": ["Letter shifting", "Symbol codes"] },
        { "name": "Blood relations & direction sense", "weight": 0.15, "pyq": 4, "difficulty": 2, "sub": ["Family trees", "Direction puzzles"] },
        { "name": "Syllogism & Venn diagrams", "weight": 0.15, "pyq": 4, "difficulty": 2, "sub": ["Statements-conclusions"] },
        { "name": "Puzzles & seating arrangement", "weight": 0.15, "pyq": 5, "difficulty": 3, "sub": ["Linear/circular seating", "Floor puzzles"] },
        { "name": "Non-verbal reasoning", "weight": 0.15, "pyq": 3, "difficulty": 2, "sub": ["Mirror/water images", "Paper folding", "Figure series"] }
