# Optional: fallback Gemini API key. The app primarily manages keys via
# Settings -> Models & Keys (stored in gitignored ./data). If you want an
# environment-level key as a fallback, set it here and run `cp .env.example .env.local`.
GEMINI_API_KEY=

# Optional: override where runtime data (db.json, keys) is stored. Default ./data
DATA_DIR=
