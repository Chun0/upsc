{
  "name": "udaan",
  "version": "1.0.0",
  "private": true,
  "description": "UDAAN — AI-powered government exam preparation copilot (single-user, local-first)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:ai": "RUN_AI=1 vitest run tests/integration",
    "keycheck": "node scripts/keycheck.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dompurify": "^3.2.3",
    "marked": "^15.0.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
